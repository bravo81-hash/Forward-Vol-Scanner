+function bullets(items, cls){
+  if(!items || !items.length) return '';
+  return `<ul class="${cls||''}">` + items.map(b=>`<li>${esc(b)}</li>`).join('') + '</ul>';
+}
+
+function renderCard(card){
+  const h = card.header || {};
+  const aside = /STAND ASIDE/.test(card.action||'');
+  const order = ['SETUP','STRUCTURE','ENTRY','EXIT','MANAGE','FLAGS'];
+  const secs = order.filter(s => (card.sections||{})[s])
+    .map(s => `<h3>${s}</h3>` + bullets(card.sections[s], s==='FLAGS'?'flags':''))
+    .join('');
+  return `<div class="card">
+      <div class="chead">
+        <span class="sym">${esc(h.symbol||'')}</span>
+        <span class="meta">$${(h.spot||0).toFixed(2)} · ${esc(h.meta||'')}</span>
+        <span class="action ${aside?'aside':''}">${esc(card.action||'')}</span>
+      </div>${secs}</div>`;
+}
+
+async function analyse(){
+  const sym = $('#sym').value.trim().toUpperCase();
+  if(!sym) return;
+  $('#out').innerHTML = '<p class="spin">Fetching chain and computing stage…</p>';
+  try{
+    const r = await fetch(`/api/equity/gate-e?symbol=${encodeURIComponent(sym)}`
+      + `&hold=${$('#hold').value}&trigger=${$('#trig').value}`);
+    const j = await r.json();
+    if(!r.ok){ $('#out').innerHTML = `<p class="err">${esc(j.error||'failed')}<br>`
+      + esc((j.errors||[]).join(' · ')) + '</p>'; return; }
+    $('#out').innerHTML = renderCard(j.card);
+  }catch(e){ $('#out').innerHTML = `<p class="err">${esc(e.message)}</p>`; }
+}
+
+async function runRadar(){
+  $('#out').innerHTML = '<p class="spin">Running Radar-B across the universe — '
+    + 'this pulls fundamentals per name and takes a minute…</p>';
+  try{
+    const r = await fetch('/api/equity/radar');
+    const j = await r.json();
+    if(!r.ok){ $('#out').innerHTML = `<p class="err">${esc(j.error||'failed')}</p>`; return; }
+    const rows = (j.watchlist||[]).map(w => `<tr class="pick" data-sym="${esc(w.symbol)}">
+        <td><strong>${esc(w.symbol)}</strong></td>
+        <td>${(w.score||0).toFixed(1)}</td>
+        <td>${((w.metrics||{}).drawdown*100||0).toFixed(0)}%</td>
+        <td>${((w.metrics||{}).atr_compression||0).toFixed(2)}x</td>
+        <td>${((w.metrics||{}).base_weeks||0).toFixed(0)}w</td></tr>`).join('');
+    $('#out').innerHTML = `<div class="card">
+      <div class="chead"><span class="sym">Radar-B watchlist</span>
+        <span class="meta">${j.qualified} qualified · showing ${j.returned}</span></div>
+      <table><thead><tr><th>Symbol</th><th>Score</th><th>Drawdown</th>
+        <th>ATR compression</th><th>Base age</th></tr></thead>
+        <tbody>${rows || '<tr><td colspan="5">No names cleared the gates.</td></tr>'}</tbody></table>
+      <p class="note">${esc(j.note||'')} Click a row to run Gate E on it.</p></div>`;
+    document.querySelectorAll('tr.pick').forEach(tr => tr.onclick = () => {
+      $('#sym').value = tr.dataset.sym; analyse();
+    });
+  }catch(e){ $('#out').innerHTML = `<p class="err">${esc(e.message)}</p>`; }
+}
+
+$('#go').onclick = analyse;
+$('#radar').onclick = runRadar;
+$('#sym').addEventListener('keydown', e => { if(e.key === 'Enter') analyse(); });
+analyse();
+</script>
+</body>
+</html>
